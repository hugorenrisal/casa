# =========================================================
#  Variables de entorno — Casa
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas el archivo .env con valores reales.
#
#  La app no tiene cuentas ni envía correo, así que la lista es corta.
#  Solo DATABASE_URL es obligatoria.
# =========================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL (Neon, Supabase, local…) ---
# Obligatoria: es donde vive el estado de la casa. Sin ella, la app arranca
# pero no puede guardar nada.
DATABASE_URL=

# --- Código de casa ---
# La llave de la casa: sin él, la API no responde. Cada móvil lo recibe una vez
# (por enlace o escribiéndolo) y lo guarda. Genera uno con:  npm run codigo
# Muy recomendado en cualquier despliegue accesible desde Internet: si se deja
# vacío, cualquiera que conozca la dirección entra. Vacío solo para probar en local.
# Pon el mismo valor como secreto CODIGO_CASA en GitHub (copias y recordatorios).
# Guía: docs/DESPLIEGUE-EN-RENDER.md
CODIGO_CASA=

# --- Avisos en el móvil (opcional) ---
# Si se dejan vacías, las claves se generan solas la primera vez y se guardan en
# la base de datos. VAPID_SUBJECT es el contacto que ven Apple/Google; en Render
# se usa la dirección del servicio.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Huso horario de la casa ---
# Decide cuándo empieza la semana y cuándo cambia el mes. Lo marca el reloj del
# SERVIDOR, no el del móvil de cada uno: así un dispositivo con la fecha mal
# puesta no reinicia el mes de todos.
TZ_FAMILIA=Europe/Madrid

# --- App de Android (TWA) ---
# Solo hace falta si publicas la app en Google Play. La huella SHA-256 la da
# Play Console después de subirla por primera vez.
ANDROID_FINGERPRINT=
ANDROID_PACKAGE=com.casa.tareas
